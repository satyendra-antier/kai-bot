GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=kai
DATABASE_URL=postgresql+psycopg://kai:kai@postgresql:5432/kai
REDIS_URL=redis://redis:6379/0
# Optional — LangGraph / Gemini traces in LangSmith (smith.langchain.com)
# Prefer a Tracing Only key (lsv2_tr_…). Service Key also works; PAT is for personal scripts.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=kai-bot
LANGCHAIN_TRACING_V2=false
